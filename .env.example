# Copy to .env and fill in. Leave LLM_PROVIDER=none to run everything
# offline (no API key, extractive/hash-based fallback) just to exercise the
# plumbing. For real answers and real eval numbers you need "openai" or
# "azure_openai" -- PwC's own reference architecture is Azure OpenAI.

LLM_PROVIDER=none

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
